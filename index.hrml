<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Two intervals الفترتين</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lemonada:wght@500;600;700&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<style>
@property --skin{syntax:'<color>';inherits:true;initial-value:#35b98a}
@property --paint{syntax:'<color>';inherits:true;initial-value:#f2ece0}
:root{
  --bg:#f6efe3; --card:#fffdf9; --ink:#2b2440; --muted:#7a7088; --line:#ebe1d0;
  --blue:#3b7cf6; --yel:#f7c51e; --yeld:#b88a00; --grn:#1fa45a; --coral:#ff5e5b; --purple:#6e4cf5;
  --code:#241f33; --code2:#2f2943;
  --mono:'JetBrains Mono',monospace; --disp:'Lemonada','Rubik',sans-serif;
  --s:min(1vh,.56vw); --s:min(1dvh,.56vw);
  --gap:calc(var(--s)*1.8); --r:calc(var(--s)*2);
  --shadow:0 calc(var(--s)*.8) calc(var(--s)*2.6) rgba(43,36,64,.10);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Rubik',sans-serif;color:var(--ink);overflow:hidden;font-size:calc(var(--s)*2.2);
  background:
    repeating-linear-gradient(45deg,rgba(43,36,64,.018) 0 2px,transparent 2px 6px),
    repeating-linear-gradient(-45deg,rgba(43,36,64,.018) 0 2px,transparent 2px 6px),
    var(--bg)}
button{font:inherit;color:inherit}
.ltr{direction:ltr;unicode-bidi:isolate;font-family:var(--mono)}
.app{height:100vh;height:100dvh;display:grid;grid-template-rows:auto 1fr auto}

.top{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--s)*2);padding:calc(var(--s)*1) calc(var(--s)*3);background:var(--ink);color:#fff;position:relative;z-index:5}
.top::after{content:"";position:absolute;left:0;right:0;bottom:-5px;height:5px;background:linear-gradient(90deg,var(--blue) 0 33%,var(--grn) 33% 66%,var(--yel) 66%)}
.brand{display:flex;align-items:center;gap:calc(var(--s)*1.4)}
.logo{width:calc(var(--s)*5.6);height:calc(var(--s)*5.6);border-radius:50% 45% 52% 48%;background:#fff;display:grid;place-items:center;flex:none}
.logo svg{width:70%;height:70%}
.brand b{display:block;font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*2.5);line-height:1.5}
.brand b .en{font-family:var(--mono);font-weight:800;font-size:.85em;color:var(--yel);margin-inline-end:8px}
.brand span{font-size:calc(var(--s)*1.6);opacity:.7;font-family:var(--mono)}
.stepper{display:flex;gap:calc(var(--s)*.4);background:rgba(255,255,255,.08);border-radius:999px;padding:calc(var(--s)*.5)}
.step-btn{display:flex;align-items:center;gap:calc(var(--s)*.7);border:0;background:transparent;border-radius:999px;padding:calc(var(--s)*.4) calc(var(--s)*1.4) calc(var(--s)*.4) calc(var(--s)*.5);cursor:pointer;font-weight:600;font-size:calc(var(--s)*1.9);color:rgba(255,255,255,.7);transition:.25s}
.step-btn i{font-style:normal;width:calc(var(--s)*3.2);height:calc(var(--s)*3.2);border-radius:50%;display:grid;place-items:center;border:2px solid rgba(255,255,255,.45);font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*1.7)}
.step-btn.done i{background:var(--grn);border-color:var(--grn)}
.step-btn.active{background:#fff;color:var(--ink)}
.step-btn.active i{background:var(--purple);border-color:var(--purple);color:#fff}
@media(max-width:1100px){.step-btn span{display:none}.step-btn{padding:calc(var(--s)*.4)}}

.stage{position:relative;overflow:hidden;overflow:clip}
.screen{position:absolute;inset:0;padding:calc(var(--s)*2.2) calc(var(--s)*3.5) calc(var(--s)*2);overflow:auto;display:flex;flex-direction:column;gap:var(--gap);opacity:0;visibility:hidden;transform:translateY(14px);transition:opacity .5s cubic-bezier(.22,1,.36,1),transform .5s cubic-bezier(.22,1,.36,1),visibility .5s}
.screen.active{opacity:1;visibility:visible;transform:none}
.screen>*{width:100%}
.screen-head{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--s)*1.6);flex-wrap:wrap;flex:none}
.screen-head>div:first-child{display:flex;align-items:center;gap:calc(var(--s)*1.6)}
.kicker{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*1.7);color:#fff;padding:calc(var(--s)*.2) calc(var(--s)*1.8);white-space:nowrap;background:var(--purple);border-radius:40% 60% 45% 55% / 60% 45% 55% 40%}
.screen-head h2{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*3.2);line-height:1.6}
.screen-head h2 .hl{color:var(--grn)}
.screen-head p{color:var(--muted);font-size:calc(var(--s)*2.1);font-weight:500}
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--gap);flex:1;min-height:0}
.split>*{min-height:0}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:calc(var(--s)*2);box-shadow:var(--shadow);position:relative}
.card.drip{border-top:calc(var(--s)*.9) solid var(--blue)}
.card.drip.y{border-top-color:var(--yel)} .card.drip.g{border-top-color:var(--grn)} .card.drip.c{border-top-color:var(--coral)}
.label{font-size:calc(var(--s)*1.8);font-weight:600;color:var(--muted);margin-bottom:calc(var(--s)*.7);display:block}

.btn{font-weight:700;font-size:calc(var(--s)*2.1);border:2px solid var(--ink);border-radius:calc(var(--s)*1.4);padding:calc(var(--s)*.8) calc(var(--s)*2.4);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:calc(var(--s)*.9);white-space:nowrap;background:#fff;transition:transform .18s cubic-bezier(.22,1,.36,1),box-shadow .2s,background .2s,opacity .2s}
.btn svg{width:calc(var(--s)*2.4);height:calc(var(--s)*2.4);flex:none}
.btn:hover{transform:translateY(-2px);box-shadow:0 4px 10px rgba(43,36,64,.15)}
.btn:active{transform:translateY(1px) scale(.98)}
.btn.pur{background:var(--purple);border-color:var(--purple);color:#fff}
.btn.grn{background:var(--grn);border-color:var(--grn);color:#fff}
.btn.icon{padding-inline:calc(var(--s)*1.2)}
.btn:disabled{opacity:.35;cursor:not-allowed;transform:none;box-shadow:none}
.btn.pulse{animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(110,76,245,.5)}50%{box-shadow:0 0 0 12px rgba(110,76,245,0)}}
.chips{display:flex;gap:calc(var(--s)*.8);flex-wrap:wrap}
.chip{font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*1.9);padding:calc(var(--s)*.3) calc(var(--s)*1.3);border-radius:999px;border:1.5px solid var(--line);background:#fff;cursor:pointer;direction:ltr;transition:.2s}
.chip:hover{border-color:var(--ink)}
.chip.active{border:2px solid var(--purple);background:#f1edff;color:var(--purple)}
.controls{display:flex;gap:calc(var(--s)*1);flex-wrap:wrap;align-items:center}
.sndbtn.off .w{display:none}.sndbtn .x{display:none}.sndbtn.off .x{display:inline}

.dock{display:flex;align-items:center;gap:calc(var(--s)*1.6);background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:calc(var(--s)*.8) calc(var(--s)*1.6);flex:none;flex-wrap:wrap;box-shadow:var(--shadow)}
.dock .txt{flex:1;min-width:200px;font-weight:500;font-size:calc(var(--s)*2.3);line-height:1.6}
.dock .txt b{color:var(--purple)}
.av{width:calc(var(--s)*6.2);height:calc(var(--s)*6.2);border-radius:50%;background:#e7f7ef;overflow:hidden;flex:none;border:2px solid var(--grn)}
.av svg{width:100%;height:100%;display:block}

/* chameleon */
.cham{flex:1 1 0;min-height:0;width:100%;--skin:#35b98a;--paint:#f2ece0;--happy:0;--oops:0;transition:--skin .7s ease,--paint .4s ease;filter:drop-shadow(0 14px 16px rgba(43,36,64,.18))}
.cham.happy{--happy:1}
.cham.oops{--oops:1}
.cham .bodyg{animation:breathe 3.4s ease-in-out infinite;transform-box:view-box;transform-origin:160px 240px}
@keyframes breathe{0%,100%{transform:scale(1,1)}50%{transform:scale(1.015,.985)}}
.cham .tail{transform-box:view-box;transform-origin:96px 200px;animation:curl 4s ease-in-out infinite}
@keyframes curl{0%,100%{transform:rotate(0)}50%{transform:rotate(-6deg)}}
.cham #pupil{transition:transform .25s cubic-bezier(.3,1.4,.5,1)}
.cham .rollerArm{transform-box:view-box;transform-origin:206px 196px;transition:transform .35s cubic-bezier(.3,1.4,.5,1)}
.cham.roll .rollerArm{animation:rollArm .5s ease-in-out infinite alternate}
@keyframes rollArm{from{transform:rotate(-5deg)}to{transform:rotate(6deg)}}

/* ===== paint component ===== */
.paint{width:100%;height:100%;display:block;overflow:visible}
.paint text{font-family:'JetBrains Mono',monospace;font-weight:800;text-anchor:middle;dominant-baseline:central}
.paint .band{fill:#fff;stroke:#e3d8c4;stroke-width:2;stroke-dasharray:8 6}
.paint .p.a{fill:var(--blue)} .paint .p.b{fill:var(--yel)} .paint .p.ov{fill:var(--grn)}
.paint .gh{fill:none;stroke-width:3;stroke-dasharray:10 7}
.paint .gh.a{stroke:var(--blue)} .paint .gh.b{stroke:var(--yeld)}
.paint .ax{stroke:var(--ink);stroke-width:3;fill:none}
.paint .tk{stroke:var(--ink);stroke-width:2}
.paint .tt{fill:var(--muted);font-weight:500}
.paint .lv.a{fill:var(--blue)} .paint .lv.b{fill:var(--yeld)}
.paint .guide{stroke-width:1.5;stroke-dasharray:4 5}
.paint .guide.a{stroke:var(--blue)} .paint .guide.b{stroke:var(--yeld)}
.paint .brk{fill:none;stroke:var(--grn);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.paint .pill{fill:var(--grn)} .paint .pill.c{fill:var(--coral)}
.paint .pillt{fill:#fff}
.paint .gap{fill:rgba(255,94,91,.14);stroke:var(--coral);stroke-width:3;stroke-dasharray:8 6}
.paint .mk{stroke:var(--purple);stroke-width:5;stroke-linecap:round}
.paint .mkh{fill:var(--purple)}
.paint .rcyl{stroke:var(--ink);stroke-width:3}
.paint .rh{stroke:var(--ink);stroke-width:5;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* ===== 1. game ===== */
.story{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:var(--gap)}
.story>*{min-height:0}
.hero{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0}
.bubble{background:#fff;border:2px solid var(--ink);border-radius:calc(var(--s)*2.4);padding:calc(var(--s)*1.2) calc(var(--s)*2.6);font-weight:600;font-size:calc(var(--s)*2.4);line-height:1.6;max-width:calc(var(--s)*58);text-align:center;position:relative;margin-bottom:calc(var(--s)*2.4);flex:none;box-shadow:5px 5px 0 rgba(110,76,245,.18)}
.bubble::after{content:"";position:absolute;bottom:calc(var(--s)*-1.25);left:50%;width:calc(var(--s)*2.2);height:calc(var(--s)*2.2);background:#fff;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:translateX(-50%) rotate(45deg)}
.bubble b{color:var(--purple)}
.bubble .bl{color:var(--blue)} .bubble .yl{color:var(--yeld)} .bubble .gr{color:var(--grn)} .bubble .cr{color:var(--coral)}
.bubble.pop{animation:bpop .45s cubic-bezier(.22,1,.36,1)}
@keyframes bpop{0%{transform:scale(.92)}60%{transform:scale(1.04)}100%{transform:scale(1)}}
.wall{display:flex;flex-direction:column;gap:calc(var(--s)*1.4)}
.wall-top{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--s)*1.2)}
.wall-title{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*2.3)}
.dots{display:flex;gap:7px;direction:ltr}
.dots i{width:calc(var(--s)*2.2);height:calc(var(--s)*2.2);border-radius:50%;border:2px solid var(--line);transition:.3s}
.dots i.cur{border-color:var(--purple);background:#f1edff}
.dots i.ok{background:var(--grn);border-color:var(--grn)}
.dots i.no{background:var(--coral);border-color:var(--coral)}
.score{font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*2.4);color:var(--grn)}
.ivs{display:flex;justify-content:center;gap:calc(var(--s)*2);direction:ltr;flex-wrap:wrap}
.iv{font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.2);padding:calc(var(--s)*.3) calc(var(--s)*2);border-radius:999px;color:#fff;transition:transform .3s}
.iv.a{background:var(--blue)} .iv.b{background:var(--yel);color:var(--ink)}
.iv.dim{opacity:.35}
.wallbox{flex:1;min-height:0;display:flex;align-items:center}
.judge{display:flex;align-items:center;justify-content:center;gap:calc(var(--s)*2);min-height:calc(var(--s)*6)}
.jbtn{display:flex;align-items:center;gap:calc(var(--s)*1);border:2.5px solid;background:#fff;cursor:pointer;border-radius:999px;padding:calc(var(--s)*.8) calc(var(--s)*2.8);font-weight:700;font-size:calc(var(--s)*2.3);transition:transform .25s cubic-bezier(.3,1.5,.5,1),background .2s,color .2s,opacity .2s}
.jbtn svg{width:calc(var(--s)*3);height:calc(var(--s)*3)}
.jbtn.y{border-color:var(--grn);color:var(--grn)}
.jbtn.n{border-color:var(--coral);color:var(--coral)}
.jbtn:hover:not(:disabled){transform:translateY(-3px)}
.jbtn.y.chosen{background:var(--grn);color:#fff}
.jbtn.n.chosen{background:var(--coral);color:#fff}
.jbtn:disabled{cursor:default;opacity:.35}
.jbtn.chosen:disabled{opacity:1}
.outline{display:flex;align-items:center;justify-content:center;gap:calc(var(--s)*1.4);min-height:calc(var(--s)*5.6)}
.outline .lbl{font-weight:600;color:var(--muted);font-size:calc(var(--s)*2)}
.outline .val{unicode-bidi:isolate;font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.4);padding:0 calc(var(--s)*1.6);border-radius:calc(var(--s)*1);opacity:0;direction:ltr}
.outline .val.y{background:#e2f6ea;color:var(--grn)} .outline .val.n{background:#ffe8e7;color:var(--coral)}

/* ===== 2. analysis ===== */
.an-grid{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:minmax(0,1fr) minmax(0,1fr);gap:var(--gap)}
.an{display:flex;flex-direction:column;gap:calc(var(--s)*.8);overflow:hidden;padding:calc(var(--s)*1.5) calc(var(--s)*2.2);transition:box-shadow .4s,transform .4s}
.an-top{display:flex;align-items:center;gap:calc(var(--s)*1.3);flex:none}
.an-ic{width:calc(var(--s)*5);height:calc(var(--s)*5);border-radius:50% 45% 55% 48%;display:grid;place-items:center;flex:none;color:#fff}
.an-ic svg{width:55%;height:55%}
.an-top h3{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*2.6)}
.an-top .num{margin-inline-start:auto;font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*2);color:#d6cab5}
.an-body{flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:calc(var(--s)*1);text-align:center;transition:opacity .45s,transform .45s cubic-bezier(.22,1,.36,1)}
.an.locked .an-body{opacity:0;transform:translateY(14px);pointer-events:none}
.an .q{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*13);color:rgba(43,36,64,.05);transition:opacity .4s;pointer-events:none}
.an:not(.locked) .q{opacity:0}
.an.locked .an-top{opacity:.5}
.an.fresh{box-shadow:0 0 0 3px var(--purple),var(--shadow)}
.an small{color:var(--muted);font-weight:500;font-size:calc(var(--s)*2)}
.an .mini{flex:1 1 0;min-height:0;width:100%;max-height:calc(var(--s)*15)}
.parts{display:flex;gap:calc(var(--s)*.8);direction:ltr;align-items:flex-end}
.part{display:flex;flex-direction:column;align-items:center;gap:calc(var(--s)*.3)}
.part b{font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.6);border-radius:calc(var(--s)*1);min-width:calc(var(--s)*6.4);padding:0 calc(var(--s)*.8);line-height:1.4;color:#fff}
.part.a b{background:var(--blue)} .part.b b{background:var(--yel);color:var(--ink)}
.part small{font-family:var(--mono);font-size:calc(var(--s)*1.6)}
.ex{display:flex;flex-direction:column;gap:calc(var(--s)*.8);width:100%;max-width:calc(var(--s)*56)}
.ex div{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--s)*1.2);direction:ltr;font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*2.5);background:var(--code);color:#f1ecff;border-radius:calc(var(--s)*1);padding:calc(var(--s)*.4) calc(var(--s)*1.6)}
.ex i{font-style:normal;color:#8a80a6}
.ex .y{color:#6fe3a0} .ex .n{color:#ff8e8b}
.rule{display:flex;flex-direction:column;gap:calc(var(--s)*.7);width:100%;max-width:calc(var(--s)*60)}
.rule div{display:flex;align-items:center;justify-content:center;gap:calc(var(--s)*1.2);font-size:calc(var(--s)*2.1);font-weight:600}
.rule code{font-family:var(--mono);font-weight:800;direction:ltr;unicode-bidi:isolate;border-radius:8px;padding:0 8px;white-space:nowrap}
.rule code.g{background:#e2f6ea;color:var(--grn)} .rule code.c{background:#ffe8e7;color:var(--coral)} .rule code.p{background:#f1edff;color:var(--purple)}

/* memory */
.mrow{display:flex;gap:calc(var(--s)*1);direction:ltr;justify-content:center;flex-wrap:wrap}
.mbox{display:flex;flex-direction:column;align-items:center;gap:calc(var(--s)*.3)}
.mbox .nm{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-weight:700;color:var(--muted);font-size:calc(var(--s)*1.7)}
.tag{font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*1.4);padding:0 calc(var(--s)*.6);border-radius:4px;line-height:1.5;color:#fff;background:var(--purple)}
.mbox b{min-width:calc(var(--s)*9);height:calc(var(--s)*6.6);display:grid;place-items:center;border-radius:calc(var(--s)*1.2);background:#fff;border:2px solid var(--ink);font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.2);padding:0 calc(var(--s)*.9);transition:background .3s,border-color .3s}
.mbox.a b{border-color:var(--blue);color:var(--blue)} .mbox.b b{border-color:var(--yeld);color:var(--yeld)}
.mbox.c b{border-color:var(--purple);border-width:3px;color:var(--purple)}
.mbox.empty b{color:#cfc4b0;border-style:dashed}
.mbox.cur b{background:#fff6c9}

/* ===== 3. design ===== */
.design{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);gap:var(--gap)}
.design>*{min-height:0}
.pseudo-card{display:flex;flex-direction:column}
.pseudo{list-style:none;display:flex;flex-direction:column;gap:calc(var(--s)*.6);flex:1;min-height:0}
.pseudo li{flex:1;min-height:0;max-height:calc(var(--s)*8);display:flex;gap:calc(var(--s)*1);align-items:center;flex-wrap:wrap;padding:0 calc(var(--s)*1.3);border-radius:calc(var(--s)*1.1);background:#fff;border:1.5px solid var(--line);font-weight:600;font-size:calc(var(--s)*2);transition:background .35s,border-color .35s,opacity .45s,transform .45s cubic-bezier(.22,1,.36,1);opacity:0;transform:translateX(-18px)}
.pseudo li.show{opacity:1;transform:none}
.pseudo li .n{font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*2);color:#d6cab5;flex:none;width:1.2em}
.pseudo li.ind{margin-inline-start:calc(var(--s)*3)}
.pseudo li.fresh{background:#e2f6ea;border-color:var(--grn)}
.pseudo li.cur{background:#f1edff;border-color:var(--purple)}
.pseudo li.cur .n{color:var(--purple)}
.pseudo code{font-family:var(--mono);font-weight:700;direction:ltr;unicode-bidi:isolate;font-size:1em;color:var(--purple)}
.progress{height:calc(var(--s)*1);border-radius:9px;background:var(--line);overflow:hidden;margin-top:calc(var(--s)*1);flex:none}
.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--grn),var(--yel));transition:width .45s cubic-bezier(.22,1,.36,1)}
.flow-card{display:flex;align-items:center;justify-content:center;padding:calc(var(--s)*.6)}
#flow{width:100%;height:100%}
#flow .node{opacity:0;transform:scale(.55);transform-box:fill-box;transform-origin:center;transition:opacity .35s,transform .55s cubic-bezier(.3,1.5,.5,1)}
#flow .node.show{opacity:1;transform:none}
#flow .sh{fill:#fff;stroke:#2b2440;stroke-width:2.2;stroke-linejoin:round;transition:fill .3s,stroke .3s}
#flow .node.dec .sh{fill:#fff8dc;stroke:#c9a000}
#flow .node.pr .sh{stroke:#6e4cf5}
#flow .node.okn .sh{stroke:#1fa45a;stroke-width:3}
#flow .node.bad .sh{stroke:#ff5e5b;stroke-width:3}
#flow text{fill:#2b2440;font-size:14px;font-weight:600;text-anchor:middle;dominant-baseline:central;font-family:'Rubik'}
#flow text.mono{font-family:'JetBrains Mono';font-weight:700;font-size:13px}
#flow text.cap{font-size:10.5px;fill:#7a7088}
#flow .node.fresh .sh{fill:#e2f6ea}
#flow .node.visited .sh{fill:#f1edff}
#flow .node.on .sh{fill:#6e4cf5;stroke:#6e4cf5}
#flow .node.on text{fill:#fff}
#flow .edge{opacity:0}
#flow .edge.show{opacity:1}
#flow .edge path{stroke:#7a7088;stroke-width:2.2;fill:none;marker-end:url(#arG);stroke-dasharray:100;stroke-dashoffset:0;stroke-linejoin:round;transition:stroke .3s,stroke-width .3s}
#flow .edge.show path{animation:draw .6s ease both}
@keyframes draw{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
#flow .edge text{font-size:12px;fill:#7a7088;font-weight:700}
#flow .edge.on path{stroke:#6e4cf5;stroke-width:4;marker-end:url(#arP)}
.trace{display:flex;flex-direction:column;justify-content:space-between;gap:calc(var(--s)*1);transition:opacity .4s}
.trace .btn{width:100%}
.trace.locked{opacity:.35;pointer-events:none}
.minibox{background:#fff;border:1.5px solid var(--line);border-radius:calc(var(--s)*1.2);padding:calc(var(--s)*.6) calc(var(--s)*1);height:calc(var(--s)*15)}
.cmpbox{background:#fff;border:1.5px dashed #d6cab5;border-radius:calc(var(--s)*1.1);padding:calc(var(--s)*.6);min-height:calc(var(--s)*6);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*2.3);direction:ltr;gap:10px;flex-wrap:wrap}
.cmpbox .t{color:var(--grn)} .cmpbox .f{color:var(--coral)} .cmpbox .p{color:var(--purple)}
.outbig{font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*4);min-height:calc(var(--s)*7);display:grid;place-items:center;background:var(--code);color:#f1ecff;border-radius:calc(var(--s)*1.3);direction:ltr}
.outbig.y{color:#6fe3a0} .outbig.n{color:#ff8e8b}

/* ===== 4. ide ===== */
.ide{background:var(--code);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow)}
.ide-bar{display:flex;align-items:center;gap:calc(var(--s)*1);padding:calc(var(--s)*.9) calc(var(--s)*2);background:var(--code2);direction:ltr;flex:none}
.ide-bar .d{width:calc(var(--s)*1.5);height:calc(var(--s)*1.5);border-radius:50%}
.ide-bar .tab{margin-left:calc(var(--s)*1.4);font-family:var(--mono);font-size:calc(var(--s)*1.9);color:#8a80a6}
.code{direction:ltr;text-align:left;font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*2.2);line-height:1.4;padding:calc(var(--s)*.8) 0;flex:1;overflow:auto;display:flex;flex-direction:column;justify-content:center}
.ln{display:flex;padding:calc(var(--s)*.3) calc(var(--s)*2) calc(var(--s)*.3) calc(var(--s)*1.4);border-left:4px solid transparent;white-space:pre;color:#ece8f7;transition:background .25s,opacity .3s}
.ln .no{width:calc(var(--s)*4);color:#5a5275;flex:none;user-select:none}
.ln.ran .no{color:#6fe3a0}
.ln.cur{background:rgba(110,76,245,.28);border-left-color:#b9a6ff}
.ln.skip{opacity:.3}
.sk{color:#ff8eb4}.sf{color:#7cc7ff}.ss{color:#ffd27a}
.va{color:#8fb6ff}.vb{color:#ffd95e}.vc{color:#c2b2ff}
.mem{display:flex;flex-direction:column;justify-content:space-between;gap:calc(var(--s)*1)}
.mem .minibox{height:calc(var(--s)*14)}
.calcl{display:flex;align-items:center;justify-content:center;gap:12px;direction:ltr;flex-wrap:wrap;background:#fff;border:1.5px dashed #d6cab5;border-radius:calc(var(--s)*1.1);min-height:calc(var(--s)*6.2);font-family:var(--mono);font-weight:700;font-size:calc(var(--s)*2.5);padding:calc(var(--s)*.4) calc(var(--s)*1.2)}
.calcl .ph2{font-family:'Rubik';font-weight:500;color:var(--muted);font-size:.75em;direction:rtl}
.calcl .t{color:var(--grn)} .calcl .f{color:var(--coral)} .calcl .p{color:var(--purple)}
.console{background:var(--code);border-radius:calc(var(--s)*1.1);padding:calc(var(--s)*.8) calc(var(--s)*2);font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.4);min-height:calc(var(--s)*7);direction:ltr;display:flex;align-items:center;gap:calc(var(--s)*1.4);color:#f1ecff}
.console .pr{color:#5a5275}
.console .y{color:#6fe3a0} .console .n{color:#ff8e8b}
.token{position:fixed;left:0;top:0;z-index:40;pointer-events:none;font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3);background:#fff;color:var(--ink);border:2px solid var(--ink);border-radius:999px;padding:0 calc(var(--s)*1.3);box-shadow:3px 3px 0 rgba(43,36,64,.25);white-space:nowrap;will-change:transform}
.token.a{background:var(--blue);color:#fff;border-color:var(--blue)}
.token.b{background:var(--yel)}
.token.c{background:var(--purple);color:#fff;border-color:var(--purple)}
.token.g{background:var(--grn);color:#fff;border-color:var(--grn)}
.token.r{background:var(--coral);color:#fff;border-color:var(--coral)}
.spark{position:fixed;left:0;top:0;pointer-events:none;z-index:70;border-radius:50%;will-change:transform}
.ring{position:fixed;left:0;top:0;pointer-events:none;z-index:69;border:3px solid var(--yel);border-radius:50%}
.shake{animation:shake .45s}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}

/* ===== 5. test ===== */
.tside{display:flex;flex-direction:column;gap:calc(var(--s)*1.4);justify-content:space-evenly}
.test-in{display:flex;gap:calc(var(--s)*1);flex-wrap:wrap}
.field{flex:1;min-width:200px;direction:ltr;font-family:var(--mono);font-weight:800;font-size:calc(var(--s)*3.6);padding:calc(var(--s)*.6) calc(var(--s)*2);border-radius:calc(var(--s)*1.2);border:2px solid var(--ink);background:#fff;color:var(--ink);outline:none;transition:box-shadow .2s}
.field:focus{box-shadow:0 0 0 4px rgba(110,76,245,.2)}
.err{color:var(--coral);font-weight:600;font-size:calc(var(--s)*1.9);min-height:calc(var(--s)*3)}
.tvis{display:flex;flex-direction:column;gap:calc(var(--s)*1.2)}
.tvis .wallbox{flex:1}
.tsteps{display:flex;flex-direction:column;gap:calc(var(--s)*.6);flex:none}
.tstep{display:flex;align-items:center;gap:calc(var(--s)*1.1);padding:calc(var(--s)*.5) calc(var(--s)*1.4);background:#fff;border:1.5px solid var(--line);border-radius:calc(var(--s)*1.1);font-weight:600;font-size:calc(var(--s)*2);opacity:.45;transition:opacity .3s,border-color .3s,background .3s}
.tstep .n{font-family:var(--mono);font-weight:800;color:#d6cab5}
.tstep .r{margin-inline-start:auto;font-family:var(--mono);font-weight:800;direction:ltr;unicode-bidi:isolate;font-size:1.15em;color:var(--purple)}
.tstep .r.t{color:var(--grn)} .tstep .r.f{color:var(--coral)}
.tstep.on{opacity:1;border-color:var(--purple);background:#f1edff}
.tstep.done{opacity:1}

/* ===== 6. improve ===== */
.seg{display:inline-flex;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:3px;gap:3px}
.seg button{border:0;background:transparent;font-weight:700;font-size:calc(var(--s)*2);padding:calc(var(--s)*.4) calc(var(--s)*1.8);border-radius:999px;cursor:pointer;display:flex;align-items:center;gap:calc(var(--s)*.8);transition:.25s}
.seg button b{font-family:var(--mono);font-size:calc(var(--s)*2)}
.seg button.on{background:var(--purple);color:#fff}
.imp-card{display:flex;flex-direction:column;gap:calc(var(--s)*1.4);justify-content:space-evenly}
.imp-card h3{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*2.7);display:flex;align-items:center;gap:calc(var(--s)*1.3)}
.imp-card p{color:var(--muted);font-weight:500;font-size:calc(var(--s)*2.3);line-height:1.6}
.imp-card .art{flex:1 1 0;min-height:calc(var(--s)*10);max-height:calc(var(--s)*24);width:100%}

.bottom{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--s)*1.6);padding:calc(var(--s)*.9) calc(var(--s)*3);background:#fff;border-top:1px solid var(--line)}
.hints{display:flex;gap:calc(var(--s)*.8);flex-wrap:wrap;justify-content:center}
.hint-btn{display:flex;align-items:center;gap:calc(var(--s)*.7);padding:calc(var(--s)*.45) calc(var(--s)*1.5);border-radius:999px;background:#f1edff;border:1.5px solid #cfc2ff;color:var(--ink);font-size:calc(var(--s)*1.9);font-weight:600;cursor:pointer;transition:transform .2s cubic-bezier(.22,1,.36,1),background .2s}
.hint-btn:hover{transform:translateY(-2px);background:#e6dfff}
.hint-btn svg{width:calc(var(--s)*2.3);height:calc(var(--s)*2.3);flex:none;color:var(--purple)}
.sheet-wrap{position:fixed;inset:0;background:rgba(43,36,64,.4);backdrop-filter:blur(3px);display:flex;align-items:flex-end;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;z-index:50}
.sheet-wrap.open{opacity:1;pointer-events:auto}
.sheet{width:min(680px,100%);max-height:86vh;overflow:auto;background:#fff;border-radius:24px 24px 0 0;padding:14px 24px 26px;transform:translateY(100%);transition:transform .45s cubic-bezier(.22,1,.36,1);box-shadow:0 -10px 30px rgba(43,36,64,.2)}
.sheet-wrap.open .sheet{transform:none}
.grab{width:50px;height:5px;border-radius:9px;background:var(--line);margin:0 auto 14px}
.sheet-head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.sheet-head .av{width:52px;height:52px}
.sheet-head h3{font-family:var(--disp);font-weight:700;font-size:20px;flex:1}
.x{width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);background:#fff;cursor:pointer;display:grid;place-items:center}
.x svg{width:18px;height:18px}
.sheet-body p{line-height:1.85;font-weight:500;font-size:17px}
.sheet-body p+p{margin-top:4px}
.sheet-body svg.paint{height:150px;margin-top:8px}
pre.snip{direction:ltr;text-align:left;background:var(--code);color:#ece8f7;border-radius:12px;padding:12px 16px;font-family:var(--mono);font-weight:700;font-size:15px;line-height:1.6;overflow:auto;margin-top:10px}
.sheet.big{width:min(1100px,96vw);height:min(90vh,calc(var(--s)*82));display:flex;flex-direction:column;padding:calc(var(--s)*1.6) calc(var(--s)*4) calc(var(--s)*3)}
.sheet.big .sheet-head h3{font-size:calc(var(--s)*3.6)}
.sheet.big .sheet-head .av{width:calc(var(--s)*7.5);height:calc(var(--s)*7.5)}
.sheet.big .sheet-body{flex:1;min-height:0;display:flex;flex-direction:column}
.nx{flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:calc(var(--s)*1.6);text-align:center}
.nx .g{font-family:var(--disp);font-weight:700;font-size:calc(var(--s)*3)}
.nx .g b{color:var(--purple)}
.nx svg.art{flex:1 1 0;min-height:calc(var(--s)*14);width:100%}
.nx .tip{display:flex;align-items:center;gap:calc(var(--s)*1.4);background:#f1edff;border:2px solid #cfc2ff;border-radius:calc(var(--s)*1.6);padding:calc(var(--s)*1.2) calc(var(--s)*2.6);font-size:calc(var(--s)*2.5);font-weight:600}
.nx .tip svg{flex:none;width:calc(var(--s)*4);height:calc(var(--s)*4);color:var(--purple)}
.nx .try{color:var(--muted);font-weight:500;font-size:calc(var(--s)*2.2)}
.nx .try a{color:var(--purple);font-weight:700}

@media(max-width:1000px) and (min-width:821px){.design{grid-template-columns:1fr 1fr}.trace{grid-column:1 / -1}}
@media(max-width:820px),(max-height:480px){
  :root{--s:6.4px}
  .story,.split,.an-grid,.design{grid-template-columns:1fr;grid-template-rows:none;flex:none}
  .cham{flex:none;height:260px}
  .wallbox{flex:none;height:190px}
  .an{min-height:230px}
  .pseudo li{flex:none;min-height:44px}
  .flow-card{height:640px}
  .code{font-size:12px}
  .screen{padding:14px 14px 20px}
  .hint-btn span,.nav-txt,.brand span{display:none}
  .hint-btn{padding:8px}
  .top,.bottom{padding:8px 12px}
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <g id="chamHead">
      <path d="M196 128 C196 90 236 70 266 92 C288 108 284 142 252 150 C226 156 198 150 196 128Z" style="fill:var(--skin)"/>
      <path d="M200 132 C214 148 246 152 266 140" stroke="rgba(255,255,255,.35)" stroke-width="5" fill="none" stroke-linecap="round"/>
      <circle cx="236" cy="108" r="21" style="fill:var(--skin)" stroke="rgba(0,0,0,.16)" stroke-width="3"/>
      <circle cx="236" cy="108" r="14" fill="#fff"/>
      <g style="opacity:calc(1 - var(--happy,0))"><circle cx="239" cy="108" r="7" fill="#2b2440"/><circle cx="241.5" cy="105.5" r="2.4" fill="#fff"/></g>
      <g style="opacity:var(--happy,0)"><circle cx="236" cy="108" r="15" style="fill:var(--skin)"/><path d="M226 111 Q236 99 246 111" stroke="#2b2440" stroke-width="4" fill="none" stroke-linecap="round"/></g>
      <path d="M256 136 Q268 137 278 127" stroke="#2b2440" stroke-width="3.5" fill="none" stroke-linecap="round" style="opacity:calc(1 - var(--oops,0))"/>
      <path d="M258 136 Q268 128 278 132" stroke="#2b2440" stroke-width="3.5" fill="none" stroke-linecap="round" style="opacity:var(--oops,0)"/>
      <circle cx="262" cy="125" r="5" fill="#ff8fa3" opacity=".45"/>
      <g transform="rotate(-14 240 80)"><ellipse cx="240" cy="82" rx="31" ry="11" fill="#ff5e5b"/><path d="M212 84 Q240 92 268 84" stroke="#d94442" stroke-width="3" fill="none"/><circle cx="240" cy="70" r="4.5" fill="#ff5e5b"/></g>
    </g>
  </defs>
</svg>

<div class="app">
  <header class="top">
    <div class="brand">
      <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round"><path d="M3 15h18" stroke="#2b2440" stroke-width="2"/><rect x="3" y="7" width="11" height="4" rx="2" fill="#3b7cf6"/><rect x="9" y="11.5" width="11" height="4" rx="2" fill="#f7c51e"/><rect x="9" y="7" width="5" height="8.5" rx="1" fill="#1fa45a"/></svg></div>
      <div><b><span class="en">Two intervals</span>الفترتين</b><span>Sheet #1 · Problem X</span></div>
    </div>
    <nav class="stepper" id="stepper"></nav>
  </header>

  <main class="stage">

    <!-- ===== 1 ===== -->
    <section class="screen active" data-title="الفكرة">
      <div class="screen-head">
        <div><span class="kicker">المرحلة 1</span><h2>الفكرة: فين اللونين <span class="hl">بيتقابلوا</span>؟</h2></div>
        <p>الأزرق + الأصفر = أخضر</p>
      </div>
      <div class="story">
        <div class="hero">
          <div class="bubble" id="chSay">هدهن خط <span class="bl">أزرق</span> وخط <span class="yl">أصفر</span>.<br>المكان اللي بيتقابلوا فيه بيبقى <span class="gr">أخضر</span>!</div>
          <svg class="cham" id="cham" viewBox="20 40 290 225" aria-label="الحرباية الرسامة">
            <ellipse cx="160" cy="250" rx="90" ry="8" fill="rgba(43,36,64,.14)"/>
            <path class="tail" d="M96 200 C44 206 32 150 70 140 C100 133 110 172 84 174 C70 175 67 159 80 158" style="stroke:var(--skin)" stroke-width="16" fill="none" stroke-linecap="round"/>
            <g class="bodyg">
              <path d="M118 208 L108 240" style="stroke:var(--skin)" stroke-width="14" stroke-linecap="round"/>
              <path d="M178 214 L176 242" style="stroke:var(--skin)" stroke-width="14" stroke-linecap="round"/>
              <ellipse cx="104" cy="243" rx="12" ry="5" style="fill:var(--skin)"/><ellipse cx="178" cy="244" rx="12" ry="5" style="fill:var(--skin)"/>
              <path d="M90 200 C88 150 128 118 180 122 C222 126 236 160 226 192 C216 222 140 230 90 200Z" style="fill:var(--skin)"/>
              <path d="M104 206 C140 222 198 220 220 198" stroke="rgba(255,255,255,.35)" stroke-width="9" fill="none" stroke-linecap="round"/>
              <path d="M120 136 l7 -12 l7 12 l7 -13 l7 13 l7 -12 l7 12 l7 -11 l7 11" style="fill:var(--skin)" stroke="rgba(0,0,0,.12)" stroke-width="2" stroke-linejoin="round"/>
              <circle cx="140" cy="162" r="9" fill="rgba(0,0,0,.10)"/><circle cx="168" cy="150" r="6" fill="rgba(0,0,0,.10)"/><circle cx="192" cy="174" r="10" fill="rgba(0,0,0,.10)"/><circle cx="150" cy="192" r="6" fill="rgba(0,0,0,.10)"/><circle cx="118" cy="182" r="5" fill="rgba(0,0,0,.10)"/>
              <path d="M196 128 C196 90 236 70 266 92 C288 108 284 142 252 150 C226 156 198 150 196 128Z" style="fill:var(--skin)"/>
              <path d="M200 132 C214 148 246 152 266 140" stroke="rgba(255,255,255,.35)" stroke-width="5" fill="none" stroke-linecap="round"/>
              <circle cx="236" cy="108" r="21" style="fill:var(--skin)" stroke="rgba(0,0,0,.16)" stroke-width="3"/>
              <circle cx="236" cy="108" r="14" fill="#fff"/>
              <g id="pupil" style="opacity:calc(1 - var(--happy,0))"><circle cx="239" cy="108" r="7" fill="#2b2440"/><circle cx="241.5" cy="105.5" r="2.4" fill="#fff"/></g>
              <g style="opacity:var(--happy,0)"><circle cx="236" cy="108" r="15" style="fill:var(--skin)"/><path d="M226 111 Q236 99 246 111" stroke="#2b2440" stroke-width="4" fill="none" stroke-linecap="round"/></g>
              <path d="M256 136 Q268 137 278 127" stroke="#2b2440" stroke-width="3.5" fill="none" stroke-linecap="round" style="opacity:calc(1 - var(--oops,0))"/>
              <path d="M258 136 Q268 128 278 132" stroke="#2b2440" stroke-width="3.5" fill="none" stroke-linecap="round" style="opacity:var(--oops,0)"/>
              <path d="M274 96 q4 7 0 10 q-4 -3 0 -10z" fill="#7cc7ff" style="opacity:var(--oops,0)"/>
              <circle cx="262" cy="125" r="5" fill="#ff8fa3" opacity=".45"/>
              <g transform="rotate(-14 240 80)"><ellipse cx="240" cy="82" rx="31" ry="11" fill="#ff5e5b"/><path d="M212 84 Q240 92 268 84" stroke="#d94442" stroke-width="3" fill="none"/><circle cx="240" cy="70" r="4.5" fill="#ff5e5b"/></g>
              <g class="rollerArm">
                <path d="M206 186 C220 196 230 200 242 198" style="stroke:var(--skin)" stroke-width="13" fill="none" stroke-linecap="round"/>
                <path d="M244 198 L270 208 L270 222" stroke="#2b2440" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="246" y="222" width="50" height="20" rx="10" style="fill:var(--paint)" stroke="#2b2440" stroke-width="3"/>
                <path d="M256 242 v7 a3 3 0 0 0 6 0 v-7z M280 242 v4 a3 3 0 0 0 6 0 v-4z" style="fill:var(--paint)"/>
                <circle cx="244" cy="198" r="7" style="fill:var(--skin)"/>
              </g>
            </g>
          </svg>
        </div>
        <div class="card wall drip">
          <div class="wall-top">
            <span class="wall-title">الحيطة</span>
            <div class="dots" id="dots"></div>
            <span class="controls"><span class="score" id="score">0/6</span><button class="btn icon sndbtn" aria-label="الصوت"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4z"/><path class="w" d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/><path class="x" d="M16 9l6 6M22 9l-6 6"/></svg></button></span>
          </div>
          <div class="ivs"><span class="iv a" id="ivA"></span><span class="iv b" id="ivB"></span></div>
          <div class="wallbox"><svg class="paint" id="gPaint"></svg></div>
          <div class="outline"><span class="lbl">المخرج:</span><span class="val" id="gOut"></span></div>
          <div class="judge">
