<script>
/* ================= logic ================= */
const SAMPLES = ["1 15 5 27", "2 5 6 12", "1 20 4 9", "5 10 10 18"];
const $ = id => document.getElementById(id);
const wait = ms => new Promise(r => setTimeout(r, ms));
const retrigger = (el, cls) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };
function parse(str){
  const t = str.trim().split(/\s+/);
  if (t.length !== 4 || !t.every(x => /^-?\d{1,9}$/.test(x))) return { err:'اكتب 4 أرقام صحيحة بينهم مسافات' };
  const [s1, e1, s2, e2] = t.map(Number);
  if (s1 > e1 || s2 > e2) return { err:'بداية كل فترة لازم تكون أصغر من نهايتها أو تساويها' };
  const cs = Math.max(s1, s2), ce = Math.min(e1, e2), ok = cs <= ce;
  return { text:`${s1} ${e1} ${s2} ${e2}`, s1, e1, s2, e2, cs, ce, ok, out: ok ? `${cs} ${ce}` : '-1' };
}

/* ================= sounds (Web Audio, synthesized) ================= */
let actx = null, soundOn = true, noiseBuf = null, master = null, revIn = null;
function ac(){
  if (!soundOn) return null;
  try {
    if (!actx){
      actx = new (window.AudioContext || window.webkitAudioContext)();
      const sr = actx.sampleRate;
      // warm pink noise
      noiseBuf = actx.createBuffer(1, sr * 2, sr);
      const d = noiseBuf.getChannelData(0);
      let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
      for (let i = 0; i < d.length; i++){
        const w = Math.random() * 2 - 1;
        b0 = .99886 * b0 + w * .0555179; b1 = .99332 * b1 + w * .0750759; b2 = .969 * b2 + w * .153852;
        b3 = .8665 * b3 + w * .3104856; b4 = .55 * b4 + w * .5329522; b5 = -.7616 * b5 - w * .016898;
        d[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * .5362) * .11; b6 = w * .115926;
      }
      // master: gentle compression, small room reverb
      const comp = actx.createDynamicsCompressor();
      comp.threshold.value = -20; comp.ratio.value = 3; comp.attack.value = .003; comp.release.value = .2;
      master = actx.createGain(); master.gain.value = .85;
      master.connect(comp); comp.connect(actx.destination);
      const conv = actx.createConvolver();
      const len = Math.floor(sr * 1.4), ir = actx.createBuffer(2, len, sr);
      for (let ch = 0; ch < 2; ch++){ const x = ir.getChannelData(ch); for (let i = 0; i < len; i++) x[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2); }
      conv.buffer = ir;
      revIn = actx.createGain(); revIn.gain.value = .5;
      const tone = actx.createBiquadFilter(); tone.type = 'lowpass'; tone.frequency.value = 5000;
      revIn.connect(conv); conv.connect(tone); tone.connect(comp);
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  } catch (e) { return null; }
}
function route(node, pan = 0, panTo = null, t = 0, dur = 0, rv = 0){
  let n = node;
  if (actx.createStereoPanner){
    const p = actx.createStereoPanner();
    p.pan.setValueAtTime(pan, t || actx.currentTime);
    if (panTo !== null) p.pan.linearRampToValueAtTime(panTo, t + dur);
    n.connect(p); n = p;
  }
  n.connect(master);
  if (rv){ const sd = actx.createGain(); sd.gain.value = rv; n.connect(sd); sd.connect(revIn); }
}
function nz({ t, dur, type = 'bandpass', f0, f1 = f0, q = 1, peak = .2, a = .01, pan = 0, panTo = null, rv = 0 }){
  const c = actx, src = c.createBufferSource(); src.buffer = noiseBuf; src.loop = true;
  const f = c.createBiquadFilter(); f.type = type; f.Q.value = q;
  f.frequency.setValueAtTime(f0, t); f.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t + dur);
  const g = c.createGain();
  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(peak, t + a); g.gain.setTargetAtTime(0, t + a, Math.max(.008, (dur - a) / 3.5));
  src.connect(f); f.connect(g); route(g, pan, panTo, t, dur, rv);
  src.start(t, Math.random() * 1.5); src.stop(t + dur + .3);
}
function os({ t, dur, f0, f1 = null, type = 'sine', peak = .1, a = .006, pan = 0, rv = 0 }){
  const c = actx, o = c.createOscillator(); o.type = type;
  o.frequency.setValueAtTime(f0, t); if (f1) o.frequency.exponentialRampToValueAtTime(f1, t + dur);
  const g = c.createGain();
  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(peak, t + a); g.gain.setTargetAtTime(0, t + a, Math.max(.01, (dur - a) / 4));
  o.connect(g); route(g, pan, null, t, dur, rv);
  o.start(t); o.stop(t + dur + .3);
}
/* soft FM bell: warm, glassy, never harsh */
function bell(f, t, dur = .8, peak = .1, rv = .35, pan = 0){
  const c = actx, car = c.createOscillator(), mod = c.createOscillator(), mg = c.createGain(), g = c.createGain();
  car.frequency.value = f; mod.frequency.value = f * 2.01;
  mg.gain.setValueAtTime(f * 1.1, t); mg.gain.setTargetAtTime(0, t, .07);
  mod.connect(mg); mg.connect(car.frequency);
  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(peak, t + .004); g.gain.setTargetAtTime(0, t + .004, dur / 4);
  car.connect(g); route(g, pan, null, t, dur, rv);
  car.start(t); mod.start(t); car.stop(t + dur + .4); mod.stop(t + dur + .4);
}
function knock(t, pan = 0, vol = 1){
  nz({ t, dur:.07, f0:1100, q:8, peak:.45 * vol, a:.002, pan });
  os({ t, dur:.14, f0:220, f1:165, peak:.22 * vol, a:.003, pan });
}

const now = () => actx.currentTime + .015;
const SND = {
  /* paint roller: sticky low grains rolling across */
  roll(dur = .9){ if (!ac()) return; const t = now(); const n = Math.max(4, Math.round(dur * 26));
    nz({ t, dur:.16, type:'lowpass', f0:900, f1:220, q:.8, peak:.22, a:.006 }); os({ t, dur:.14, f0:150, f1:70, peak:.12, a:.004 });
    for (let i = 0; i < n; i++){ const k = i / n; nz({ t:t + .05 + k * dur, dur:.07 + Math.random() * .04, f0:340 + Math.random() * 380, q:1.6, peak:.07 + Math.random() * .05, a:.012, pan:-.5 + k, rv:.15 }); }
    nz({ t:t + dur, dur:.12, type:'lowpass', f0:700, f1:180, q:.8, peak:.14, a:.004, pan:.5 }); },
  /* colors mixing into green: bubbly sparkle */
  mix(){ if (!ac()) return; const t = now(); [784, 988, 1175, 1568].forEach((f, i) => bell(f, t + i * .07, .9, .085, .55, (i - 1.5) * .35)); nz({ t, dur:.5, f0:2500, f1:6000, q:2, peak:.05, a:.1, rv:.5 }); },
  splat(){ if (!ac()) return; const t = now(); nz({ t, dur:.18, type:'lowpass', f0:1400, f1:200, q:1.2, peak:.32, a:.003 }); os({ t, dur:.16, f0:220, f1:60, peak:.18, a:.003 }); },
  tick(){ if (!ac()) return; const t = now(); nz({ t, dur:.04, f0:3400, f1:2600, q:2.5, peak:.2, a:.002 }); os({ t, dur:.04, f0:2200, peak:.03 }); },
  yes(){ if (!ac()) return; const t = now(); bell(880, t, .7, .12, .35, -.15); bell(1319, t + .09, .8, .1, .4, .15); },
  no(){ if (!ac()) return; const t = now(); os({ t, dur:.32, f0:392, f1:330, type:'triangle', peak:.1, a:.015 }); os({ t, dur:.32, f0:196, f1:165, peak:.08, a:.015 }); },
  move(dur = .6){ if (!ac()) return; const t = now(); nz({ t, dur, f0:520, f1:2200, q:1.3, peak:.14, a:dur * .35, pan:-.35, panTo:.35 }); },
  snap(){ if (!ac()) return; const t = now(); os({ t, dur:.22, f0:120, f1:55, peak:.3, a:.004 }); os({ t, dur:.06, f0:430, f1:950, peak:.09, a:.003 }); bell(1568, t + .04, .8, .08, .45, -.2); bell(2093, t + .07, .8, .06, .45, .2); },
  type(){ if (!ac()) return; const t = now(); nz({ t, dur:.035, f0:1900, q:1.4, peak:.18, a:.002, pan:(Math.random() - .5) * .3 }); os({ t, dur:.04, f0:150, peak:.045, a:.002 }); },
  win(){ if (!ac()) return; const t = now(); [1047, 1319, 1568, 2093].forEach((f, i) => bell(f, t + i * .1, 1.1, .1, .5, (i - 1.5) * .3)); [2637, 3136, 3951].forEach((f, i) => bell(f, t + .45 + i * .06, .6, .03, .6, (i - 1) * .6)); }
};
function setSound(on){ soundOn = on; document.querySelectorAll('.sndbtn').forEach(b => b.classList.toggle('off', !on)); }
document.querySelectorAll('.sndbtn').forEach(b => b.onclick = () => setSound(!soundOn));

/* ================= motion helpers ================= */
const easeIO = p => p < .5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
function arcFrames(x0, y0, x1, y1, lift, rot = 0, sMid = 1.06, n = 36){
  const f = [];
  for (let i = 0; i <= n; i++){ const p = i / n, e = easeIO(p), b = Math.sin(Math.PI * e);
    f.push({ transform:`translate(${x0 + (x1 - x0) * e}px,${y0 + (y1 - y0) * e - lift * b}px) rotate(${rot * b}deg) scale(${1 + (sMid - 1) * b})`, offset:p }); }
  return f;
}
function squash(el, big = 1){
  const k = [[0,0],[.16,-.2],[-.07,.09],[.035,-.04],[-.015,.018],[0,0]];
  return el.animate(k.map(([x, y], i) => ({ transform:`scale(${1 + x * big},${1 + y * big})`, offset:i / (k.length - 1) })), { duration:560, easing:'linear' }).finished;
}
const SPARK_C = ['#1fa45a', '#3b7cf6', '#f7c51e', '#6e4cf5', '#ff5e5b'];
function burst(x, y, n = 14, colors = SPARK_C){
  const ring = document.createElement('div'); ring.className = 'ring'; ring.style.borderColor = colors[0]; document.body.appendChild(ring);
  ring.animate([{ transform:`translate(${x - 6}px,${y - 6}px) scale(.3)`, width:'12px', height:'12px', opacity:1 }, { transform:`translate(${x - 34}px,${y - 34}px) scale(1)`, width:'68px', height:'68px', opacity:0 }],
    { duration:560, easing:'cubic-bezier(.22,1,.36,1)', fill:'forwards' }).finished.then(() => ring.remove());
  for (let i = 0; i < n; i++){
    const d = document.createElement('div'), sz = 5 + Math.random() * 7;
    d.className = 'spark';
    Object.assign(d.style, { width:sz + 'px', height:sz + 'px', background:colors[i % colors.length] });
    document.body.appendChild(d);
    const a = Math.PI * 2 * i / n + Math.random() * .4, dist = 30 + Math.random() * 50;
    d.animate([{ transform:`translate(${x}px,${y}px) scale(1)`, opacity:1 }, { transform:`translate(${x + Math.cos(a) * dist}px,${y + Math.sin(a) * dist + 10}px) scale(.3)`, opacity:0 }],
      { duration:650 + Math.random() * 250, easing:'cubic-bezier(.2,.7,.3,1)', fill:'forwards' }).finished.then(() => d.remove());
  }
}
const center = el => { const r = el.getBoundingClientRect(); return { x:r.left + r.width / 2, y:r.top + r.height / 2 }; };

/* ================= paint wall component ================= */
const NS = 'http://www.w3.org/2000/svg';
function mk(tag, attrs, parent){ const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }
function niceStep(span, maxT){ const raw = span / maxT, p = Math.pow(10, Math.floor(Math.log10(raw))); for (const m of [1, 2, 5, 10]) if (m * p >= raw) return Math.max(1, m * p); return 1; }
function makePaint(svg, opt = {}){
  const c = !!opt.compact, fs = c ? 1.35 : 1;
  const W = 1000, BY = c ? 86 : 100, BH = c ? 46 : 60, AX = BY + BH + (c ? 26 : 34), H = AX + (c ? 44 : 44);
  const x0 = 60, x1 = 940;
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.setAttribute('direction', 'ltr');
  let lo = 0, hi = 10, G = {};
  const X = v => x0 + (v - lo) / (hi - lo) * (x1 - x0);
  const T = (txt, x, y, cls, size) => { const e = mk('text', { x, y, class:cls, 'font-size':size * fs }, G.top); e.textContent = txt; return e; };
  function setRange(a, b){
    lo = a; hi = b;
    svg.innerHTML = '';
    G.band = mk('rect', { x:x0 - 10, y:BY, width:x1 - x0 + 20, height:BH, rx:12, class:'band' }, svg);
    G.guides = mk('g', {}, svg); G.ghost = mk('g', {}, svg); G.paint = mk('g', {}, svg); G.over = mk('g', {}, svg); G.res = mk('g', {}, svg); G.marks = mk('g', {}, svg);
    const ax = mk('g', {}, svg);
    mk('path', { d:`M${x0 - 26} ${AX} H${x1 + 26}`, class:'ax' }, ax);
    const st = niceStep(hi - lo, c ? 7 : 11);
    for (let v = Math.ceil(lo / st) * st; v <= hi; v += st){
      mk('path', { d:`M${X(v)} ${AX - 7} V${AX + 7}`, class:'tk' }, ax);
      const t = mk('text', { x:X(v), y:AX + 24 * fs, class:'tt', 'font-size':18 * fs }, ax); t.textContent = v;
    }
    G.top = mk('g', {}, svg);
    G.roller = mk('g', { opacity:0 }, svg);
    mk('path', { d:`M0 ${BY - 6} V${BY - 34} L30 ${BY - 46} V${BY - 78}`, class:'rh' }, G.roller);
    mk('rect', { x:22, y:BY - 104, width:16, height:30, rx:6, fill:'#ff5e5b', stroke:'#2b2440', 'stroke-width':3 }, G.roller);
    G.cyl = mk('rect', { x:-13, y:BY - 6, width:26, height:BH + 12, rx:11, class:'rcyl' }, G.roller);
  }
  function auto(r){ const a = Math.min(r.s1, r.s2), b = Math.max(r.e1, r.e2), pad = Math.max(1, Math.round((b - a) * .08)); setRange(a - pad, b + pad); }
  function strip(which, l, r, parent){
    const w = Math.max(10, X(r) - X(l));
    return mk('rect', { x:X(l) - (r === l ? 5 : 0), y:BY + 5, width:w, height:BH - 10, rx:8, class:'p ' + which }, parent);
  }
  function labels(which, l, r){
    const y = which === 'a' ? BY - 16 * fs : BY + BH + 15 * fs;
    mk('path', { d:`M${X(l)} ${BY - 4} V${BY + BH + 4}`, class:'guide ' + which }, G.guides);
    mk('path', { d:`M${X(r)} ${BY - 4} V${BY + BH + 4}`, class:'guide ' + which }, G.guides);
    if (l === r){ T(l, X(l), y, 'lv ' + which, 19); return; }
    T(l, X(l), y, 'lv ' + which, 19); T(r, X(r), y, 'lv ' + which, 19);
  }
  return {
    X, setRange, auto,
    ghost(which, l, r){ const w = Math.max(10, X(r) - X(l)); mk('rect', { x:X(l) - (r === l ? 5 : 0), y:BY + 5, width:w, height:BH - 10, rx:8, class:'gh ' + which }, G.ghost); },
    clearGhost(){ G.ghost.innerHTML = ''; },
    instant(which, l, r){ strip(which, l, r, G.paint); labels(which, l, r); },
    overlapInstant(a, b){ if (a <= b) strip('ov', a, b, G.over); },
    async paint(which, l, r, dur = 1000, other = null, onMove){
      const rect = mk('rect', { x:X(l), y:BY + 5, width:0, height:BH - 10, rx:8, class:'p ' + which }, G.paint);
      const ov = other ? mk('rect', { y:BY + 5, width:0, height:BH - 10, rx:8, class:'p ov' }, G.over) : null;
      G.cyl.style.fill = which === 'a' ? 'var(--blue)' : 'var(--yel)';
      G.roller.setAttribute('opacity', 1);
      SND.roll(dur / 1000);
      let mixed = false;
      await new Promise(res => {
        const t0 = performance.now();
        const f = tm => {
          const p = Math.min(1, (tm - t0) / dur), e = easeIO(p), cur = l + (r - l) * e;
          rect.setAttribute('width', Math.max(0, X(cur) - X(l)));
          if (ov){ const a = Math.max(l, other[0]), b = Math.min(cur, other[1]);
            if (b >= a){ ov.setAttribute('x', X(a)); ov.setAttribute('width', Math.max(0, X(b) - X(a))); if (!mixed && b > a){ mixed = true; onMove && onMove(p, true); } } }
          G.roller.setAttribute('transform', `translate(${X(cur)} ${Math.sin(p * Math.PI * 6) * 2})`);
          onMove && onMove(p, false);
          p < 1 ? requestAnimationFrame(f) : res();
        };
        requestAnimationFrame(f);
      });
      if (l === r){ rect.setAttribute('x', X(l) - 5); rect.setAttribute('width', 10); }
      if (ov){ const a = Math.max(l, other[0]), b = Math.min(r, other[1]); if (a === b){ ov.setAttribute('x', X(a) - 5); ov.setAttribute('width', 10); } }
      const fade = G.roller.animate([{ opacity:1 }, { opacity:0 }], { duration:250, fill:'forwards' }); fade.finished.then(() => { G.roller.setAttribute('opacity', 0); fade.cancel(); });
      labels(which, l, r);
      return ov;
    },
    reveal(cs, ce, animate = true){
      const g = mk('g', {}, G.res);
      const ty = BY - 66 * fs + (c ? 6 : 0);
      if (cs <= ce){
        const xa = X(cs) - (cs === ce ? 5 : 0), xb = X(ce) + (cs === ce ? 5 : 0), y = BY - 40 * fs + (c ? 8 : 0);
        mk('path', { d:`M${xa} ${y + 12} V${y} H${xb} V${y + 12}`, class:'brk' }, g);
        const label = `${cs} ${ce}`, w = (label.length * 13 + 26) * fs, mx = Math.min(Math.max((xa + xb) / 2, x0 + w / 2), x1 - w / 2);
        mk('rect', { x:mx - w / 2, y:ty - 16 * fs, width:w, height:32 * fs, rx:16 * fs, class:'pill' }, g);
        const t = mk('text', { x:mx, y:ty, class:'pillt', 'font-size':20 * fs }, g); t.textContent = label;
      } else {
        mk('rect', { x:X(ce) + 4, y:BY + 2, width:Math.max(6, X(cs) - X(ce) - 8), height:BH - 4, rx:8, class:'gap' }, g);
        const mx = (X(ce) + X(cs)) / 2, w = 54 * fs;
        mk('rect', { x:mx - w / 2, y:ty - 16 * fs, width:w, height:32 * fs, rx:16 * fs, class:'pill c' }, g);
        const t = mk('text', { x:mx, y:ty, class:'pillt', 'font-size':20 * fs }, g); t.textContent = '-1';
      }
      if (animate) g.animate([{ opacity:0, transform:'translateY(10px)' }, { opacity:1, transform:'none' }], { duration:450, easing:'cubic-bezier(.22,1,.36,1)' });
      return g;
    },
    marker(v, animate = false){
      const g = mk('g', {}, G.marks);
      mk('path', { d:`M${X(v)} ${BY - 2} V${BY + BH + 2}`, class:'mk' }, g);
      mk('path', { d:`M${X(v) - 9} ${BY - 14} H${X(v) + 9} L${X(v)} ${BY - 2}Z`, class:'mkh' }, g);
      if (animate) g.animate([{ transform:'translateY(-30px)', opacity:0 }, { transform:'translateY(4px)', opacity:1, offset:.7 }, { transform:'none', opacity:1 }], { duration:500, easing:'cubic-bezier(.22,1,.36,1)' });
      return g;
    },
    clearMarks(){ G.marks.innerHTML = ''; },
    pulseOver(){ [...G.over.children].forEach(el => el.animate([{ opacity:1 }, { opacity:.45 }, { opacity:1 }, { opacity:.6 }, { opacity:1 }], { duration:900 })); },
    overRect(){ return G.over.lastChild; }
  };
}
/* draws a full finished picture instantly */
function drawStatic(P, r, opt = {}){
  P.auto(r); P.instant('a', r.s1, r.e1); P.instant('b', r.s2, r.e2);
  if (opt.overlap !== false) P.overlapInstant(r.cs, r.ce);
  if (opt.result !== false) P.reveal(r.cs, r.ce, false);
}

/* ================= navigation ================= */
const screens = [...document.querySelectorAll('.screen')];
let cur = 0;
screens.forEach((s, i) => { const b = document.createElement('button'); b.className = 'step-btn'; b.innerHTML = `<i>${i+1}</i><span>${s.dataset.title}</span>`; b.onclick = () => go(i); $('stepper').appendChild(b); });
function go(i){
  if (i < 0 || i >= screens.length || i === cur) return;
  screens[cur].classList.remove('active'); screens[i].classList.add('active');
  cur = i; syncNav();
  if (cur !== 2){ stopFlow(); stopBuildAll(); }
  if (cur !== 3) stopIde();
}
function syncNav(){
  [...$('stepper').children].forEach((b, i) => { b.classList.toggle('active', i === cur); b.classList.toggle('done', i < cur); });
  $('prev').disabled = cur === 0; $('next').disabled = cur === screens.length - 1;
  if (cur !== 0) $('next').classList.remove('pulse');
}
$('prev').onclick = () => go(cur - 1);
$('next').onclick = () => go(cur + 1);
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT') return;
  if (e.key === 'Escape') return closeSheet();
  if ($('sheetWrap').classList.contains('open')) return;
  if (e.key === 'ArrowLeft') go(cur + 1);
  if (e.key === 'ArrowRight') go(cur - 1);
});
syncNav();

/* ================= 1. game ================= */
const ROUNDS = ["1 15 5 27", "2 5 6 12", "4 9 1 20", "10 14 3 8", "5 10 10 18", "3 12 6 9"];
const gP = makePaint($('gPaint')), ch = $('cham');
const SKIN = { base:'#35b98a', a:'#3b7cf6', b:'#e9b80f', g:'#1fa45a', grey:'#9aa3a0' };
let gi = 0, gScore = 0, gBusy = false, res = [];
const setFace = f => { ch.classList.remove('happy', 'oops'); if (f) ch.classList.add(f); };
const skin = c => ch.style.setProperty('--skin', c);
const paintColor = c => ch.style.setProperty('--paint', c);
const look = p => $('pupil').style.transform = `translate(${-6 + 10 * p}px, ${p > 0 ? 2 : 0}px)`;
function renderDots(){ $('dots').innerHTML = ROUNDS.map((_, i) => `<i class="${res[i] === true ? 'ok' : res[i] === false ? 'no' : i === gi ? 'cur' : ''}"></i>`).join(''); $('score').textContent = `${gScore}/${ROUNDS.length}`; }
async function loadRound(){
  gBusy = true;
  const r = parse(ROUNDS[gi]);
  $('gOut').style.opacity = 0;
  ['jY','jN'].forEach(id => { $(id).classList.remove('chosen'); $(id).disabled = true; $(id).style.display = ''; });
  $('gNext').style.display = 'none';
  $('ivA').textContent = `[${r.s1}, ${r.e1}]`; $('ivB').textContent = `[${r.s2}, ${r.e2}]`;
  $('ivB').classList.add('dim'); $('ivA').classList.remove('dim');
  setFace(null); skin(SKIN.a); paintColor('#3b7cf6');
  $('chSay').innerHTML = 'بدهن الفترة <span class="bl">الزرقا</span>…'; retrigger($('chSay'), 'pop');
  renderDots();
  gP.auto(r);
  ch.classList.add('roll');
  await gP.paint('a', r.s1, r.e1, 1000, null, p => look(p));
  ch.classList.remove('roll'); look(.5);
  gP.ghost('b', r.s2, r.e2); $('ivB').classList.remove('dim');
  skin(SKIN.base); paintColor('#f2ece0');
  $('chSay').innerHTML = 'لما أدهن <span class="yl">الأصفر</span>…<br>هيقابل <span class="bl">الأزرق</span>؟'; retrigger($('chSay'), 'pop');
  ['jY','jN'].forEach(id => $(id).disabled = false);
  gBusy = false;
}
async function guess(saysMeet){
  if (gBusy) return; gBusy = true;
  const r = parse(ROUNDS[gi]);
  ['jY','jN'].forEach(id => $(id).disabled = true);
  $(saysMeet ? 'jY' : 'jN').classList.add('chosen'); SND.tick();
  await wait(250);
  gP.clearGhost(); skin(SKIN.b); paintColor('#f7c51e'); ch.classList.add('roll');
  await gP.paint('b', r.s2, r.e2, 1100, [r.s1, r.e1], (p, mixed) => { look(p); if (mixed){ skin(SKIN.g); SND.mix(); } });
  ch.classList.remove('roll'); look(.5);
  if (r.ok){ gP.pulseOver(); const o = gP.overRect(); if (o){ const c = center(o); burst(c.x, c.y, 18); } }
  await wait(300);
  gP.reveal(r.cs, r.ce); SND.splat();
  const right = saysMeet === r.ok;
  res[gi] = right; if (right) gScore++;
  renderDots();
  const o = $('gOut'); o.textContent = r.out; o.className = 'val ' + (r.ok ? 'y' : 'n');
  o.animate([{ opacity:0, transform:'scale(.6)' }, { opacity:1, transform:'scale(1.1)', offset:.6 }, { opacity:1, transform:'scale(1)' }], { duration:450, easing:'cubic-bezier(.22,1,.36,1)', fill:'forwards' });
  await wait(350);
  skin(r.ok ? SKIN.g : SKIN.grey);
  setFace(right ? 'happy' : 'oops');
  const why = r.ok ? (r.cs === r.ce ? `لمسوا في نقطة واحدة: <span class="gr">${r.cs}</span>` : `الأخضر من <span class="gr">${r.cs}</span> لحد <span class="gr">${r.ce}</span>`) : 'مفيش ولا نقطة مشتركة، يبقى <span class="cr ltr">-1</span>';
  $('chSay').innerHTML = (right ? '<b>عين فنان!</b> ' : '<b>قربت!</b> ') + '<br>' + why;
  retrigger($('chSay'), 'pop');
  (right ? SND.yes : SND.no)();
  ['jY','jN'].forEach(id => $(id).style.display = 'none');
  const last = gi === ROUNDS.length - 1;
  $('gNext').style.display = '';
  $('gNext').innerHTML = last ? 'العب تاني' : 'الجولة الجاية<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>';
  if (last){ setTimeout(() => { SND.win(); setFace('happy'); $('chSay').innerHTML = `خلصنا الحيطة!<br>توقعت صح <b>${gScore} من ${ROUNDS.length}</b>`; retrigger($('chSay'), 'pop'); }, 1300); $('next').classList.add('pulse'); }
  gBusy = false;
}
$('jY').onclick = () => guess(true);
$('jN').onclick = () => guess(false);
$('gNext').onclick = () => { if (gBusy) return; if (gi === ROUNDS.length - 1){ gi = 0; gScore = 0; res = []; } else gi++; loadRound(); };
renderDots(); loadRound();

/* ================= 2. analysis ================= */
const anCards = [...document.querySelectorAll('.an')];
const anP = makePaint($('anPaint'), { compact:true });
drawStatic(anP, parse("1 15 5 27"));
const AN_SAY = [
  'قبل الكود، لازم نفهم المسألة. دوس "اكشف"',
  'بنقرا 4 أرقام: بداية ونهاية الفترة الأولى، وبعدهم التانية',
  'لو فيه جزء مشترك نطبع بدايته ونهايته. لو مفيش نطبع <b class="ltr">-1</b>',
  'السر كله: البداية المشتركة <b>الأكبر</b>، والنهاية المشتركة <b>الأصغر</b>',
  'لو البداية طلعت بعد النهاية يبقى مفيش تقاطع. ولو زي بعض يبقى نقطة واحدة'
];
let an = 0;
function renderAn(){
  anCards.forEach((c, i) => { c.classList.toggle('locked', i >= an); c.classList.toggle('fresh', i === an - 1); });
  $('anSay').innerHTML = AN_SAY[an];
  $('anNextTxt').innerHTML = an >= 4 ? 'يلا للتصميم' : `اكشف <span class="ltr">(${an}/4)</span>`;
}
$('anNext').onclick = () => { if (an >= 4) return go(2); an++; SND.splat(); renderAn(); };
$('anReset').onclick = () => { an = 0; renderAn(); };
renderAn();

/* ================= 3. design ================= */
const BUILD = [
  { els:['n-start'], say:'كل برنامج ليه بداية' },
  { els:['e-1','n-in'], say:'نقرا الـ 4 أرقام' },
  { els:['e-2','n-d1','e-y1','n-p1','e-n1','n-p2'], say:'البداية المشتركة = <b>الأكبر</b> بين البدايتين' },
  { els:['e-m1','e-m2','n-d2','e-y2','n-p3','e-n2','n-p4'], say:'النهاية المشتركة = <b>الأصغر</b> بين النهايتين' },
  { els:['e-m3','e-m4','n-d3'], say:'هل البداية قبل النهاية أو عندها؟' },
  { els:['e-y3','n-oY'], say:'أيوه: نطبع البداية والنهاية' },
  { els:['e-n3','n-oN'], say:'لأ: نطبع <b class="ltr">-1</b>' },
  { els:['e-ye','e-ne','n-end'], say:'التصميم خلص! اختار مثال ودوس "تشغيل"' }
];
const NODE_LINE = { 'n-start':0, 'n-in':1, 'n-d1':2, 'n-p1':2, 'n-p2':2, 'n-d2':3, 'n-p3':3, 'n-p4':3, 'n-d3':4, 'n-oY':5, 'n-oN':6, 'n-end':7 };
const pLines = [...document.querySelectorAll('#pseudo li')];
let built = 0, buildAllTimer = null;
function buildStep(){
  if (built >= BUILD.length) return;
  document.querySelectorAll('#flow .fresh, #pseudo .fresh').forEach(el => el.classList.remove('fresh'));
  const step = BUILD[built];
  pLines[built].classList.add('show', 'fresh');
  step.els.forEach((id, k) => setTimeout(() => { $(id).classList.add('show'); if (id.startsWith('n-')) $(id).classList.add('fresh'); }, k * 160));
  SND.splat(); $('dsSay').innerHTML = step.say;
  built++; syncBuild();
}
function syncBuild(){
  $('buildBar').style.width = (built / BUILD.length * 100) + '%';
  const fin = built >= BUILD.length;
  $('bNext').disabled = fin; $('bAll').disabled = fin;
  $('bNextTxt').innerHTML = `ابني <span class="ltr">(${built}/${BUILD.length})</span>`;
  $('trace').classList.toggle('locked', !fin);
  if (fin) setTimeout(() => document.querySelectorAll('#flow .fresh').forEach(el => el.classList.remove('fresh')), 1000);
}
function stopBuildAll(){ clearInterval(buildAllTimer); buildAllTimer = null; }
function resetBuild(){
  stopBuildAll(); stopFlow(); resetTrace(); built = 0;
  pLines.forEach(li => li.classList.remove('show','fresh','cur'));
  document.querySelectorAll('#flow .node,#flow .edge').forEach(el => el.classList.remove('show','fresh'));
  $('dsSay').innerHTML = 'يلا نبني الحل سوا. دوس "ابني"'; syncBuild();
}
$('bNext').onclick = () => { stopBuildAll(); buildStep(); };
$('bAll').onclick = () => { if (buildAllTimer) return; buildStep(); buildAllTimer = setInterval(() => { if (built >= BUILD.length) return stopBuildAll(); buildStep(); }, 750); };
$('bReset').onclick = resetBuild;

const fP = makePaint($('fPaint'), { compact:true });
let flowInput = SAMPLES[0], ideInput = SAMPLES[0], custom = null, flowTimer = null;
function resetTrace(){
  document.querySelectorAll('#flow .on,#flow .visited').forEach(el => el.classList.remove('on','visited'));
  pLines.forEach(li => li.classList.remove('cur'));
  const r = parse(flowInput); fP.auto(r); fP.ghost('a', r.s1, r.e1); fP.ghost('b', r.s2, r.e2);
  $('fCmp').textContent = '—'; $('fOut').className = 'outbig'; $('fOut').textContent = '';
}
function stopFlow(){ clearTimeout(flowTimer); flowTimer = null; $('flowRun').disabled = false; }
function runFlow(){
  stopFlow(); resetTrace();
  const r = parse(flowInput);
  const tf = ok => `<span class="${ok ? 't' : 'f'}">${ok ? 'True' : 'False'}</span>`;
  const ask = (txt, ok) => () => { $('fCmp').innerHTML = `<span>${txt}</span>${tf(ok)}`; SND.tick(); setTimeout(ok ? SND.yes : SND.no, 230); };
  const setS = (name, v) => () => { $('fCmp').innerHTML = `<span class="p">common_start = ${name} = ${v}</span>`; fP.marker(v, true); SND.snap(); };
  const setE = (name, v) => () => { $('fCmp').innerHTML = `<span class="p">common_end = ${name} = ${v}</span>`; fP.marker(v, true); SND.snap(); };
  const q = [{ n:'n-start' }, { e:'e-1' }, { n:'n-in', fx:() => { fP.clearGhost(); fP.instant('a', r.s1, r.e1); fP.instant('b', r.s2, r.e2); $('fCmp').textContent = r.text; SND.splat(); } }, { e:'e-2' }];
  const b1 = r.s1 > r.s2, b2 = r.e1 < r.e2;
  q.push({ n:'n-d1', slow:true, fx:ask(`${r.s1} > ${r.s2}`, b1) });
  q.push(b1 ? { e:'e-y1' } : { e:'e-n1' });
  q.push(b1 ? { n:'n-p1', slow:true, fx:setS('start1', r.s1) } : { n:'n-p2', slow:true, fx:setS('start2', r.s2) });
  q.push(b1 ? { e:'e-m1' } : { e:'e-m2' });
  q.push({ n:'n-d2', slow:true, fx:ask(`${r.e1} < ${r.e2}`, b2) });
  q.push(b2 ? { e:'e-y2' } : { e:'e-n2' });
  q.push(b2 ? { n:'n-p3', slow:true, fx:setE('end1', r.e1) } : { n:'n-p4', slow:true, fx:setE('end2', r.e2) });
  q.push(b2 ? { e:'e-m3' } : { e:'e-m4' });
  q.push({ n:'n-d3', slow:2, fx:() => { ask(`${r.cs} <= ${r.ce}`, r.ok)(); fP.overlapInstant(r.cs, r.ce); fP.reveal(r.cs, r.ce); } });
  const out = () => { $('fOut').textContent = r.out; $('fOut').className = 'outbig ' + (r.ok ? 'y' : 'n'); SND.type(); setTimeout(SND.type, 100); };
  if (r.ok) q.push({ e:'e-y3' }, { n:'n-oY', fx:out }, { e:'e-ye' }); else q.push({ e:'e-n3' }, { n:'n-oN', fx:out }, { e:'e-ne' });
  q.push({ n:'n-end', fx:() => SND.win() });
  let k = 0;
  $('flowRun').disabled = true;
  $('dsSay').innerHTML = `بنمشي على الفلوتشارت بالمدخل <span class="ltr">${flowInput}</span>`;
  const tick = () => {
    if (k >= q.length){ flowTimer = null; $('flowRun').disabled = false; $('dsSay').innerHTML = 'خلصنا! جرّب مثال تاني عشان تشوف طريق تاني'; return; }
    const s = q[k++];
    document.querySelectorAll('#flow .on').forEach(el => el.classList.remove('on'));
    $(s.n || s.e).classList.add('on', 'visited');
    if (s.n){ pLines.forEach(li => li.classList.remove('cur')); pLines[NODE_LINE[s.n]].classList.add('cur'); }
    if (s.fx) s.fx();
    flowTimer = setTimeout(tick, s.e ? 260 : s.slow === 2 ? 1500 : s.slow ? 1100 : 650);
  };
  tick();
}
$('flowRun').onclick = runFlow;
resetBuild();

/* ================= chips ================= */
function renderChips(box, active, onPick){
  const list = [...SAMPLES]; if (custom && !list.includes(custom)) list.push(custom);
  box.innerHTML = '';
  list.forEach(s => { const b = document.createElement('button'); b.className = 'chip' + (s === active ? ' active' : ''); b.textContent = s; b.onclick = () => onPick(s); box.appendChild(b); });
}
function refreshChips(){
  renderChips($('flowChips'), flowInput, s => { flowInput = s; stopFlow(); resetTrace(); refreshChips(); });
  renderChips($('ideChips'), ideInput, s => { if (ideBusy) return; ideInput = s; stopIde(); resetIde(); refreshChips(); });
  renderChips($('tChips'), $('tIn').value.trim().replace(/\s+/g, ' '), s => { if (tBusy) return; $('tIn').value = s; runTest(true); });
}

/* ================= 4. IDE ================= */
const A1 = '<span class="va">start1</span>', A2 = '<span class="va">end1</span>', B1 = '<span class="vb">start2</span>', B2 = '<span class="vb">end2</span>';
const CS = '<span class="vc">common_start</span>', CE = '<span class="vc">common_end</span>';
const CODE = [
  `${A1}, ${A2}, ${B1}, ${B2} = <span class="sf">map</span>(<span class="sf">int</span>, <span class="sf">input</span>().<span class="sf">split</span>())`,
  `<span class="sk">if</span> ${A1} > ${B1}:`,
  `    ${CS} = ${A1}`,
  `<span class="sk">else</span>:`,
  `    ${CS} = ${B1}`,
  `<span class="sk">if</span> ${A2} < ${B2}:`,
  `    ${CE} = ${A2}`,
  `<span class="sk">else</span>:`,
  `    ${CE} = ${B2}`,
  `<span class="sk">if</span> ${CS} <= ${CE}:`,
  `    <span class="sf">print</span>(${CS}, ${CE})`,
  `<span class="sk">else</span>:`,
  `    <span class="sf">print</span>(-1)`
];
const SHORT = [
  `${A1}, ${A2}, ${B1}, ${B2} = <span class="sf">map</span>(<span class="sf">int</span>, <span class="sf">input</span>().<span class="sf">split</span>())`,
  `${CS} = <span class="sf">max</span>(${A1}, ${B1})`,
  `${CE} = <span class="sf">min</span>(${A2}, ${B2})`,
  `<span class="sk">if</span> ${CS} <= ${CE}:`,
  `    <span class="sf">print</span>(${CS}, ${CE})`,
  `<span class="sk">else</span>:`,
  `    <span class="sf">print</span>(-1)`
];
const codeHTML = lines => lines.map((l, i) => `<div class="ln"><span class="no">${i+1}</span><span>${l || ' '}</span></div>`).join('');
$('code').innerHTML = codeHTML(CODE);
const lnEls = [...$('code').querySelectorAll('.ln')];
const mP = makePaint($('mPaint'), { compact:true });

let IB = null, idePos = -1, ideTimer = null, ideBusy = false;
function ideBuild(r){
  const b1 = r.s1 > r.s2, b2 = r.e1 < r.e2;
  const L = [{ line:0, kind:'read', say:'بنقرا 4 أرقام ونحوّلهم كلهم لـ int مرة واحدة' }];
  L.push({ line:1, kind:'ask', txt:`${r.s1} > ${r.s2}`, ok:b1, hl:['start1','start2'], say:`مين بدأ متأخر؟ هل <span class="ltr">${r.s1} > ${r.s2}</span>؟ <b>${b1 ? 'أيوه' : 'لأ'}</b>` });
  if (b1) L.push({ line:2, kind:'setS', from:'start1', say:`البداية المشتركة = start1 = <b>${r.s1}</b>` });
  else { L.push({ line:3, kind:'else', say:'لأ، نروح على else' }); L.push({ line:4, kind:'setS', from:'start2', say:`البداية المشتركة = start2 = <b>${r.s2}</b>` }); }
  L.push({ line:5, kind:'ask', txt:`${r.e1} < ${r.e2}`, ok:b2, hl:['end1','end2'], say:`مين خلص بدري؟ هل <span class="ltr">${r.e1} < ${r.e2}</span>؟ <b>${b2 ? 'أيوه' : 'لأ'}</b>` });
  if (b2) L.push({ line:6, kind:'setE', from:'end1', say:`النهاية المشتركة = end1 = <b>${r.e1}</b>` });
  else { L.push({ line:7, kind:'else', say:'لأ، نروح على else' }); L.push({ line:8, kind:'setE', from:'end2', say:`النهاية المشتركة = end2 = <b>${r.e2}</b>` }); }
  L.push({ line:9, kind:'check', say:`هل البداية (<span class="ltr">${r.cs}</span>) قبل النهاية (<span class="ltr">${r.ce}</span>) أو عندها؟ <b>${r.ok ? 'أيوه' : 'لأ'}</b>` });
  if (r.ok) L.push({ line:10, kind:'print', say:`فيه جزء مشترك، بنطبع <b class="ltr">${r.out}</b>` });
  else { L.push({ line:11, kind:'else', say:'البداية بعد النهاية، يعني مفيش تقاطع' }); L.push({ line:12, kind:'print', say:'بنطبع <b class="ltr">-1</b>' }); }
  return { S:L, r };
}
function stateAt(k){
  const r = IB.r, m = { v:{}, cs:null, ce:null, hl:[], calc:null, out:'', done:[], read:false, checked:false };
  for (let i = 0; i <= k; i++){
    const s = IB.S[i]; m.hl = []; m.calc = null; m.done.push(s.line);
    if (s.kind === 'read'){ m.read = true; m.v = { start1:r.s1, end1:r.e1, start2:r.s2, end2:r.e2 }; m.hl = ['start1','end1','start2','end2']; }
    if (s.kind === 'ask'){ m.hl = s.hl; m.calc = `<span>${s.txt}</span><span class="${s.ok ? 't' : 'f'}">${s.ok ? 'True' : 'False'}</span>`; }
    if (s.kind === 'setS'){ m.cs = r.cs; m.hl = ['common_start']; m.calc = `<span class="p">common_start = ${s.from} = ${r.cs}</span>`; }
    if (s.kind === 'setE'){ m.ce = r.ce; m.hl = ['common_end']; m.calc = `<span class="p">common_end = ${s.from} = ${r.ce}</span>`; }
    if (s.kind === 'check'){ m.checked = true; m.hl = ['common_start','common_end']; m.calc = `<span>${r.cs} <= ${r.ce}</span><span class="${r.ok ? 't' : 'f'}">${r.ok ? 'True' : 'False'}</span>`; }
    if (s.kind === 'print') m.out = r.out;
  }
  return m;
}
function mb(name, cls, v, hl){
  return `<div class="mbox ${cls}${v == null ? ' empty' : ''}${hl.includes(name) ? ' cur' : ''}" data-v="${name}"><span class="nm">${name}<span class="tag">int</span></span><b>${v == null ? '—' : v}</b></div>`;
}
function renderMini(m){
  const r = IB.r; mP.auto(r);
  if (!m.read){ mP.ghost('a', r.s1, r.e1); mP.ghost('b', r.s2, r.e2); return; }
  mP.instant('a', r.s1, r.e1); mP.instant('b', r.s2, r.e2);
  if (m.checked){ mP.overlapInstant(r.cs, r.ce); mP.reveal(r.cs, r.ce, false); }
  if (m.cs != null) mP.marker(m.cs);
  if (m.ce != null) mP.marker(m.ce);
}
function renderIde(memK = idePos, landed = true){
  const m = stateAt(memK), st = IB.S[idePos], hl = landed ? m.hl : [];
  const fin = idePos >= IB.S.length - 1;
  const used = new Set(IB.S.map(s => s.line));
  lnEls.forEach((el, i) => { el.classList.toggle('cur', !!st && st.line === i); el.classList.toggle('ran', m.done.includes(i)); el.classList.toggle('skip', fin && !used.has(i)); });
  $('memRow').innerHTML = mb('start1', 'a', m.v.start1, hl) + mb('end1', 'a', m.v.end1, hl) + mb('start2', 'b', m.v.start2, hl) + mb('end2', 'b', m.v.end2, hl);
  $('memRow2').innerHTML = mb('common_start', 'c', m.cs, hl) + mb('common_end', 'c', m.ce, hl);
  renderMini(m);
  $('calcLane').innerHTML = landed && m.calc ? m.calc : '<span class="ph2">هنا هتشوف كل مقارنة</span>';
  $('conOut').innerHTML = m.out ? `<span class="${IB.r.ok ? 'y' : 'n'}">${m.out}</span>` : '';
  $('ideSay').innerHTML = st ? st.say : 'دوس "خطوة" وتابع الكود';
  $('ideStep').disabled = ideBusy || fin;
}
const boxB = n => document.querySelector(`.mem .mbox[data-v="${n}"] b`);
function flyToken(text, from, to, dur, cls = ''){
  const t = document.createElement('div'); t.className = 'token ' + cls; t.textContent = text; document.body.appendChild(t);
  const w = t.offsetWidth, h = t.offsetHeight;
  const fr = arcFrames(from.x - w / 2, from.y - h / 2, to.x - w / 2, to.y - h / 2, 50, 0, 1.12);
  fr.forEach((k, i) => k.opacity = Math.min(1, i / 4));
  return t.animate(fr, { duration:dur, easing:'linear', fill:'forwards' }).finished.then(() => t.remove());
}
async function animateStep(k){
  const s = IB.S[k], r = IB.r, D = 760;
  if (s.kind === 'read'){
    const lr = lnEls[0].getBoundingClientRect(), from = { x:lr.left + lr.width * .7, y:lr.top + lr.height / 2 };
    SND.move(1);
    await Promise.all([['start1', r.s1, 'a'], ['end1', r.e1, 'a'], ['start2', r.s2, 'b'], ['end2', r.e2, 'b']].map(([n, v, c], i) => wait(i * 110).then(() => flyToken(String(v), from, center(boxB(n)), D, c))));
  } else if (s.kind === 'ask'){
    s.hl.forEach(n => boxB(n).parentElement.classList.add('cur')); SND.tick(); await wait(380); (s.ok ? SND.yes : SND.no)(); await wait(260);
  } else if (s.kind === 'setS' || s.kind === 'setE'){
    const to = s.kind === 'setS' ? 'common_start' : 'common_end';
    SND.move(.7);
    await flyToken(String(s.kind === 'setS' ? r.cs : r.ce), center(boxB(s.from)), center(boxB(to)), D, 'c');
  } else if (s.kind === 'check'){
    ['common_start','common_end'].forEach(n => boxB(n).parentElement.classList.add('cur'));
    SND.tick(); await wait(400); (r.ok ? SND.yes : SND.no)(); await wait(260);
  } else if (s.kind === 'else'){ SND.tick(); await wait(320); }
  else if (s.kind === 'print'){
    SND.move(.7);
    await flyToken(r.out, center($('mPaint')), center($('conOut').parentElement), 700, r.ok ? 'g' : 'r');
  }
}
async function ideNext(){
  if (ideBusy) return;
  if (idePos >= IB.S.length - 1){ stopIde(); return; }
  idePos++; ideBusy = true;
  renderIde(idePos - 1, false);
  await animateStep(idePos);
  ideBusy = false;
  renderIde(idePos, true);
  const st = IB.S[idePos];
  if (st.kind === 'read'){ SND.splat(); ['start1','end1','start2','end2'].forEach(n => { const b = boxB(n); squash(b); const c = center(b); burst(c.x, c.y - 6, 7); }); }
  if (st.kind === 'setS' || st.kind === 'setE'){ SND.snap(); const b = boxB(st.kind === 'setS' ? 'common_start' : 'common_end'); squash(b); const c = center(b); burst(c.x, c.y - 6, 8); }
  if (st.kind === 'check' && IB.r.ok){ SND.mix(); }
  if (st.kind === 'print'){ setTimeout(SND.win, 150); const c = center($('conOut')); burst(c.x, c.y, 16); }
  if (idePos >= IB.S.length - 1) stopIde();
}
function resetIde(){ IB = ideBuild(parse(ideInput)); idePos = -1; ideBusy = false; renderIde(); }
function stopIde(){ clearInterval(ideTimer); ideTimer = null; $('ideRun').querySelector('span').textContent = 'تشغيل تلقائي'; }
$('ideStep').onclick = () => { stopIde(); ideNext(); };
$('ideReset').onclick = () => { if (ideBusy) return; stopIde(); resetIde(); };
$('ideRun').onclick = () => {
  if (ideTimer) return stopIde();
  if (ideBusy) return;
  if (idePos >= IB.S.length - 1) resetIde();
  $('ideRun').querySelector('span').textContent = 'إيقاف';
  ideNext(); ideTimer = setInterval(ideNext, 1800);
};
resetIde();

/* ================= 5. test ================= */
let tBusy = false;
const tP = makePaint($('tPaint'));
function prepTest(r){
  $('tA').textContent = `[${r.s1}, ${r.e1}]`; $('tB').textContent = `[${r.s2}, ${r.e2}]`;
  tP.auto(r); tP.ghost('a', r.s1, r.e1); tP.ghost('b', r.s2, r.e2);
  $('tSteps').innerHTML = [
    ['البداية المشتركة = الأكبر', `max(${r.s1}, ${r.s2}) = ${r.cs}`, ''],
    ['النهاية المشتركة = الأصغر', `min(${r.e1}, ${r.e2}) = ${r.ce}`, ''],
    [`<span class="ltr">${r.cs} <= ${r.ce}</span> ؟`, r.ok ? 'True' : 'False', r.ok ? 't' : 'f']
  ].map(([k, v, c], i) => `<div class="tstep" id="ts${i}"><span class="n">${i+1}</span><span>${k}</span><span class="r ${c}" id="tr${i}" data-v="${v}"></span></div>`).join('');
  $('tOut').className = 'outbig'; $('tOut').textContent = '';
}
async function runTest(animate = true){
  if (tBusy) return;
  const raw = $('tIn').value.trim().replace(/\s+/g, ' '), r = parse(raw);
  if (r.err){ $('tErr').textContent = r.err; retrigger($('tIn'), 'shake'); return; }
  $('tErr').textContent = '';
  if (!SAMPLES.includes(r.text)) custom = r.text;
  $('tIn').value = r.text; refreshChips();
  prepTest(r);
  if (!animate){ drawStatic(tP, r); [0,1,2].forEach(i => { $('tr' + i).textContent = $('tr' + i).dataset.v; $('ts' + i).classList.add('done'); }); $('tOut').textContent = r.out; $('tOut').className = 'outbig ' + (r.ok ? 'y' : 'n'); return; }
  tBusy = true; ['tRun','tRand'].forEach(id => $(id).disabled = true);
  tP.clearGhost();
  await tP.paint('a', r.s1, r.e1, 800);
  await tP.paint('b', r.s2, r.e2, 900, [r.s1, r.e1], (p, mixed) => { if (mixed) SND.mix(); });
  const show = async (i, f) => { const row = $('ts' + i); row.classList.add('on'); SND.tick(); await wait(300); if (f) await f(); $('tr' + i).textContent = $('tr' + i).dataset.v; await wait(350); row.classList.remove('on'); row.classList.add('done'); };
  await show(0, async () => { tP.marker(r.cs, true); SND.snap(); });
  await show(1, async () => { tP.marker(r.ce, true); SND.snap(); });
  await show(2, async () => { (r.ok ? SND.yes : SND.no)(); await wait(150); tP.reveal(r.cs, r.ce); SND.splat(); });
  $('tOut').textContent = ''; $('tOut').className = 'outbig ' + (r.ok ? 'y' : 'n');
  for (const chr of r.out){ $('tOut').textContent += chr; SND.type(); await wait(80); }
  SND.win();
  ['tRun','tRand'].forEach(id => $(id).disabled = false); tBusy = false;
}
$('tRun').onclick = () => runTest(true);
$('tIn').addEventListener('keydown', e => { if (e.key === 'Enter') runTest(true); });
$('tRand').onclick = () => {
  if (tBusy) return;
  const rnd = n => Math.floor(Math.random() * n);
  const s1 = rnd(15), e1 = s1 + 1 + rnd(10), s2 = rnd(20), e2 = s2 + 1 + rnd(10);
  $('tIn').value = `${s1} ${e1} ${s2} ${e2}`; runTest(true);
};
refreshChips(); runTest(false);

/* ================= 6. improve ================= */
function showVersion(v){
  [...$('seg').children].forEach(b => b.classList.toggle('on', +b.dataset.v === v));
  $('impCode').innerHTML = codeHTML(v ? SHORT : CODE);
  $('impTab').textContent = v ? 'intervals_short.py' : 'intervals.py';
}
[...$('seg').children].forEach(b => b.onclick = () => showVersion(+b.dataset.v));
showVersion(0);
$('nextBtn').onclick = () => openSheet('next');

/* ================= hints ================= */
const SHEETS = {
  big: {
    label:'ليه الأكبر؟', title:'البداية المشتركة = الأكبر',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
    demo:"1 15 5 27",
    html:'<p>الجزء المشترك لازم يكون جوه الفترتين مع بعض. فمش هيبدأ غير لما <b>الاتنين</b> يكونوا بدأوا، يعني عند البداية المتأخرة.</p>'
  },
  small: {
    label:'ليه الأصغر؟', title:'النهاية المشتركة = الأصغر',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>',
    demo:"4 9 1 20",
    html:'<p>أول ما أي فترة <b>تخلص</b>، الجزء المشترك يخلص معاها. يعني عند النهاية اللي بدري.</p>'
  },
  touch: {
    label:'لمسة نقطة', title:'لو لمسوا بعض في نقطة',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M2 12h6M16 12h6"/></svg>',
    demo:"5 10 10 18",
    html:'<p>الفترة الأولى بتخلص عند 10، والتانية بتبدأ عند 10. البداية = النهاية، فالمشترك نقطة واحدة ونطبع <b class="ltr">10 10</b>. علشان كده الشرط <span class="ltr">&lt;=</span> مش <span class="ltr">&lt;</span>.</p>'
  },
  maxmin: {
    label:'max و min', title:'دوال جاهزة في بايثون',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-12 5 12M6 13h6M16 6v12"/></svg>',
    html:`<p>بدل الـ if/else، بايثون فيها <span class="ltr">max</span> بترجّع الأكبر و <span class="ltr">min</span> بترجّع الأصغر:</p>
      <pre class="snip">max(1, 5)    # 5
min(15, 27)  # 15</pre>`
  }
};
const NEXT = {
  title:'التحدي الجاي: The Last 2 Digits',
  html:`<div class="nx">
    <div class="g">نضرب كذا رقم كبير… والمطلوب <b>آخر رقمين</b> بس</div>
    <svg class="art" viewBox="0 0 640 220" direction="ltr" font-family="JetBrains Mono" font-weight="800">
      <text x="320" y="96" text-anchor="middle" font-size="76" fill="#2b2440" letter-spacing="4">12<tspan fill="#6e4cf5">34</tspan></text>
      <rect x="318" y="30" width="148" height="92" rx="16" fill="none" stroke="#6e4cf5" stroke-width="5" stroke-dasharray="12 9"/>
      <text x="320" y="182" text-anchor="middle" font-size="40" fill="#7a7088">1234 ÷ 100 = 12 <tspan fill="#6e4cf5">+ ?</tspan></text>
    </svg>
    <div class="tip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>لما تقسم 1234 على 100… الباقي كام؟ وده يطلع إيه من الرقم؟</div>
    <div class="try">اقرأ المسألة وجرّب بنفسك الأول · <a href="https://codeforces.com/group/MWSDmqGsZm/contest/219158/problem/Y" target="_blank" rel="noopener">افتح المسألة Y</a></div>
  </div>`
};
Object.entries(SHEETS).forEach(([k, s]) => { const b = document.createElement('button'); b.className = 'hint-btn'; b.innerHTML = `${s.icon}<span>${s.label}</span>`; b.onclick = () => openSheet(k); $('hints').appendChild(b); });
function openSheet(k){
  const d = k === 'next' ? NEXT : SHEETS[k];
  document.querySelector('.sheet').className = 'sheet' + (k === 'next' ? ' big' : '');
  $('sheetTitle').textContent = d.title; $('sheetBody').innerHTML = d.html;
  if (d.demo){ const svg = document.createElementNS(NS, 'svg'); svg.setAttribute('class', 'paint'); $('sheetBody').appendChild(svg); const P = makePaint(svg, { compact:true }); const r = parse(d.demo); drawStatic(P, r); P.marker(r.cs); P.marker(r.ce); }
  $('sheetWrap').classList.add('open');
}
function closeSheet(){ $('sheetWrap').classList.remove('open'); }
$('sheetClose').onclick = closeSheet;
$('sheetWrap').onclick = e => { if (e.target.id === 'sheetWrap') closeSheet(); };
</script>
</body>
</html>
